@model DevTrack.Models.DevTrackViewModel

@{
    ViewData["Title"] = "Dashboard";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div style="margin-top:40px; text-align:center;">
        <h2>@Model.ErrorMessage</h2>
        <a href="/">Voltar</a>
    </div>
}
else
{
    <div class="dashboard-container">
        <div style="display:flex; justify-content:flex-end; margin-bottom:20px;">
            <button id="theme-toggle" class="theme-toggle" type="button">Ativar modo escuro</button>
        </div>

        <div style="display:flex; align-items:center; gap:20px; margin-bottom:30px;">
            <img src="@Model.User.AvatarUrl" alt="Avatar" width="120" style="border-radius:50%;" />

            <div>
                <h1>@Model.User.Name (@Model.User.Login)</h1>
                <p>@Model.User.Bio</p>
                <p><strong>Localização:</strong> @Model.User.Location</p>
                <p>
                    <strong>Seguidores:</strong> @Model.User.Followers |
                    <strong>Seguindo:</strong> @Model.User.Following |
                    <strong>Repositórios:</strong> @Model.User.PublicRepos
                </p>
                <p>
                    <a href="@Model.User.HtmlUrl" target="_blank">Ver perfil no GitHub</a>
                </p>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:15px; margin-bottom:30px;">

            <div class="insight-card">
                <p class="insight-title">Linguagem principal</p>
                <h3 class="insight-value">@Model.MainLanguage</h3>
            </div>

            <div class="insight-card">
                <p class="insight-title">Total de stars</p>
                <h3 class="insight-value">@Model.TotalStars</h3>
            </div>

            <div class="insight-card">
                <p class="insight-title">Repositório mais popular</p>
                <h3 class="insight-value">
                    @(Model.MostStarredRepo != null ? Model.MostStarredRepo.Name : "N/A")
                </h3>
            </div>

            <div class="insight-card">
                <p class="insight-title">Último repositório atualizado</p>
                <h3 class="insight-value">
                    @(Model.MostRecentlyUpdatedRepo != null ? Model.MostRecentlyUpdatedRepo.Name : "N/A")
                </h3>
            </div>

            <div class="insight-card">
                <p class="insight-title">Status do desenvolvedor</p>
                <h3 class="insight-value @Model.DeveloperStatusClass">
                    @Model.DeveloperStatus
                </h3>
            </div>

            <div class="insight-card">
                <p class="insight-title">Última atividade</p>
                <h3 class="insight-value">
                    @Model.LastActivityRelative
                </h3>
            </div>

            <div class="insight-card score-highlight">
                <p class="insight-title">Developer Score</p>

                <h3 class="insight-value">
                    @Model.DeveloperScore / 100
                </h3>

                <p style="font-size:13px; opacity:0.7;">
                    Nível: @Model.DeveloperLevel
                </p>

                <div class="score-bar">
                    <div class="score-fill" style="width:@Model.DeveloperScore%"></div>
                </div>
            </div>

        </div>

        <div style="margin-top:30px; margin-bottom:30px;">
            <h2 style="margin-bottom:15px;">Insights automáticos</h2>

            @if (Model.Insights != null && Model.Insights.Any())
            {
                <div style="display:grid; gap:12px;">
                    @foreach (var insight in Model.Insights)
                    {
                        <div style="
                            background:#ffffff;
                            border:1px solid #e5e7eb;
                            border-radius:12px;
                            padding:14px 16px;
                            box-shadow:0 4px 10px rgba(0,0,0,0.05);
                            ">
                            @insight
                        </div>
                    }
                </div>
            }
            else
            {
                <p>Nenhum insight disponível.</p>
            }
        </div>

        <hr />

        <h2>Repositórios</h2>

        @if (Model.Repositories.Any())
        {
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:20px; margin-top:20px;">
                @foreach (var repo in Model.Repositories.Take(12))
                {
                    <div style="padding:20px; border:1px solid #ddd; border-radius:12px; background:#fafafa;">

                        <h3 style="margin-top:0; word-break: break-word; font-size:18px;">
                            <a href="@repo.HtmlUrl" target="_blank" style="text-decoration:none;">
                                @repo.Name
                            </a>
                        </h3>

                        <p style="color:#555;">
                            @(string.IsNullOrWhiteSpace(repo.Description) ? "Este repositório não possui descrição." : repo.Description)
                        </p>

                        <div style="font-size:14px; color:#666; margin-top:10px;">
                            <span><strong>Linguagem:</strong> @repo.Language</span>
                            <br />
                            <span>⭐ @repo.Stars</span>
                            &nbsp;&nbsp;
                            <span>Forks: @repo.Forks</span>
                        </div>

                        <div style="font-size:13px; color:#888; margin-top:8px;">
                            Atualizado @repo.UpdatedRelative
                        </div>

                    </div>
                }
            </div>
        }
        else
        {
            <p>Nenhum repositório encontrado.</p>
        }

        <hr style="margin:40px 0;" />

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:25px;">
            <div style="padding:20px; border:1px solid #ddd; border-radius:14px;">
                <h2>Linguagens mais usadas</h2>

                @if (Model.Languages.Any())
                {
                    <canvas id="languagesChart" height="120"></canvas>

                    <ul style="padding-left:20px; margin-top:20px;">
                        @foreach (var language in Model.Languages.OrderByDescending(x => x.Value))
                        {
                            <li><strong>@language.Key</strong>: @language.Value repositório(s)</li>
                        }
                    </ul>
                }
                else
                {
                    <p>Nenhuma linguagem encontrada.</p>
                }
            </div>

            <div style="padding:20px; border:1px solid #ddd; border-radius:14px;">
                <h2>Atividade recente</h2>

                @if (Model.Events.Any())
                {
                    <ul style="padding-left:20px; margin:0;">
                        @foreach (var item in Model.Events.Take(10))
                        {
                            <li style="margin-bottom:8px;">
                                <strong>@item.TypeDisplay</strong> em <strong>@item.Repo?.Name</strong><br />
                                <span style="color:#666;">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>Nenhuma atividade recente encontrada.</p>
                }
            </div>
        </div>

        <div style="margin-top:30px;">
            <a href="/" style="font-weight:600;">← Nova busca</a>
        </div>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

@if (Model.Languages.Any())
{
    <script>
        const labels = [
        @Html.Raw(string.Join(",", Model.Languages.Keys.Select(l => $"'{l}'")))
        ];

        const data = [
        @string.Join(",", Model.Languages.Values)
        ];

        const ctx = document.getElementById('languagesChart');

        new Chart(ctx, {
        type: 'pie',
        data: {
        labels: labels,
        datasets: [{
        label: 'Quantidade de repositórios',
        data: data,
        borderWidth: 1
        }]
        },
        options: {
        responsive: true,
        plugins: {
        legend: {
        display: true,
        position: 'bottom'
        }
        }
        }
        });
    </script>
}
<script>
    document.addEventListener("DOMContentLoaded", function () {
    const themeToggle = document.getElementById("theme-toggle");
    const body = document.body;

    const savedTheme = localStorage.getItem("devtrack-theme");

    if (savedTheme === "dark") {
    body.classList.add("dark-mode");
    themeToggle.textContent = "Ativar modo claro";
    }

    themeToggle.addEventListener("click", function () {
    body.classList.toggle("dark-mode");

    const isDark = body.classList.contains("dark-mode");

    localStorage.setItem("devtrack-theme", isDark ? "dark" : "light");
    themeToggle.textContent = isDark ? "Ativar modo claro" : "Ativar modo escuro";
    });
    });
</script>